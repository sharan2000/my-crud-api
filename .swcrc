{
  "jsc": {
    "parser": {
      "syntax": "ecmascript",
      "jsx": false
    },
    "target": "es2022",
    "minify": {
      "compress": {
        "unused": true,
        "dead_code": true
        // "drop_console": true
      },
      "mangle": true
    }
  },
  "minify": true,
  "module": {
    "type": "commonjs"
  }
}
